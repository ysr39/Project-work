    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard KPIs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin","dashboard"] }
          }
        },
        {
          "name": "List All Trips",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/trips?page=1&limit=20",
              "host": ["{{baseUrl}}"], "path": ["admin","trips"],
              "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Pending Driver Approvals",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/drivers/pending?page=1&limit=20",
              "host": ["{{baseUrl}}"], "path": ["admin","drivers","pending"],
              "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Approve Driver",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/admin/drivers/{{driverId}}/approve", "host": ["{{baseUrl}}"], "path": ["admin","drivers","{{driverId}}","approve"] }
          }
        },
        {
          "name": "Reject Driver",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
