      ]
    },

    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment Intent",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const body = pm.response.json();",
                "const data = body.data ?? body;",
                "if (data.paymentId) pm.collectionVariables.set('paymentId', data.paymentId);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/payments/intent", "host": ["{{baseUrl}}"], "path": ["payments","intent"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripPassengerId\": \"{{passengerId}}\",\n  \"paymentMethod\":   \"CARD\"\n}"
            }
          }
        },
        {
          "name": "Payment History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/history?page=1&limit=10",
              "host": ["{{baseUrl}}"], "path": ["payments","history"],
              "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }]
            }
          }
        },
        {
          "name": "Refund Payment (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/payments/admin/{{paymentId}}/refund", "host": ["{{baseUrl}}"], "path": ["payments","admin","{{paymentId}}","refund"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountRupees\": 50,\n  \"reason\":       \"Driver no-show\"\n}"
            }
          }
        },
        {
          "name": "List All Payments (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/admin/all?page=1&limit=20&status=CAPTURED",
              "host": ["{{baseUrl}}"], "path": ["payments","admin","all"],
              "query": [
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "20" },
                { "key": "status", "value": "CAPTURED" }
              ]
            }
          }
        }
      ]
    },

