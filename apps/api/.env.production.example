# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://taxipool.app
ADMIN_URL=https://admin.taxipool.app

# ── Database (pulled from SSM in ECS; keep here for reference only) ────────────
DATABASE_HOST=<rds-endpoint>
DATABASE_PORT=5432
DATABASE_NAME=taxipool
DATABASE_USER=<from-ssm>
DATABASE_PASSWORD=<from-ssm>
DATABASE_SSL=true

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=<elasticache-primary-endpoint>
REDIS_PORT=6379
REDIS_PASSWORD=<from-ssm>
REDIS_TLS=true

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=<from-ssm>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<from-ssm>
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_<from-ssm>
STRIPE_WEBHOOK_SECRET=whsec_<from-ssm>
STRIPE_CURRENCY=inr

# ── Firebase (FCM) ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=<from-ssm>
FIREBASE_PRIVATE_KEY=<from-ssm>
FIREBASE_CLIENT_EMAIL=<from-ssm>

# ── Twilio ─────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=<from-ssm>
TWILIO_AUTH_TOKEN=<from-ssm>
TWILIO_PHONE_NUMBER=<from-ssm>

# ── Google Maps ────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=<from-ssm>

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=taxipool-documents-<account-id>
# In ECS use the task IAM role — no static keys needed
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY only for local dev

# ── Throttle ───────────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
