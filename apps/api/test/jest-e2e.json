{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1"
  },
  "globalSetup":    "./setup/global-setup.ts",
  "globalTeardown": "./setup/global-teardown.ts",
  "setupFilesAfterFramework": ["./setup/jest-setup.ts"]
}
